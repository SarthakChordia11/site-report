---
import '../styles/global.css';

interface Props {
  title?: string;
  activeModule?: string;
}

const { title = 'Site Manager AI', activeModule = 'dashboard' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AI-powered construction site management platform" />
    <title>{title} — Site Manager AI</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-[#F7F7F7] text-[#0E0E0E] font-sans antialiased">
    <div class="min-h-screen flex">
      <slot name="sidebar" />
      <div class="flex-1 lg:pl-64 flex flex-col min-w-0">
        <slot name="header" />
        <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full">
          <slot />
        </main>
      </div>
    </div>
    <slot name="modals" />
  </body>
</html>
