---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Page Not Found">
  <div class="min-h-screen flex flex-col items-center justify-center gap-6 text-center p-8">
    <div class="w-20 h-20 rounded-2xl bg-orange-50 border border-orange-200 flex items-center justify-center text-4xl">
      🏗️
    </div>
    <div>
      <h1 class="text-4xl font-bold text-[#0E0E0E] mb-2">404 — Page Not Found</h1>
      <p class="text-[#6B7280] max-w-sm">The page you're looking for doesn't exist or has moved.</p>
    </div>
    <a href="/" class="px-6 py-3 bg-[#FF6A00] text-white font-bold rounded-xl hover:bg-orange-600 transition-colors">
      ← Back to Home
    </a>
  </div>
</PublicLayout>
