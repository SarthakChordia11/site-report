---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Page Not Found">
  <div class="min-h-screen bg-[#0B0E17] bg-grid flex flex-col items-center justify-center gap-6 text-center p-8 relative overflow-hidden">
    <div class="absolute inset-0 bg-radial-hero pointer-events-none" />
    <div class="w-16 h-16 rounded-2xl bg-[#FF5E14]/15 border border-[#FF5E14]/30 flex items-center justify-center text-[#FF5E14] relative z-10 shadow-xl">
      <svg className="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
    </div>
    <div class="relative z-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-2 tracking-tight">404 — Page Not Found</h1>
      <p class="text-neutral-400 max-w-sm text-sm">The page you're looking for doesn't exist or has moved.</p>
    </div>
    <a href="/" class="relative z-10 px-8 py-3 bg-[#FF5E14] hover:bg-[#E04F0F] text-white font-bold rounded-full text-sm transition-all shadow-xl shadow-[#FF5E14]/20 cursor-pointer">
      Back to Home
    </a>
  </div>
</PublicLayout>
